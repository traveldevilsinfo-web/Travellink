# ---------- Public (safe in browser) ----------
NEXT_PUBLIC_SITE_URL=https://triplink.in
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_WHATSAPP_NUMBER=91XXXXXXXXXX

# ---------- Server only (NEVER prefix with NEXT_PUBLIC_) ----------
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=                      # CI migrations only

RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=             # current account used for payouts
RAZORPAYX_WEBHOOK_SECRET=

WHATSAPP_API_BASE=                    # BSP or graph.facebook.com
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=                  # X-Hub-Signature-256 verification
WHATSAPP_VERIFY_TOKEN=

MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=                # DLT-approved
SUPABASE_SMS_HOOK_SECRET=             # Send SMS Hook signature secret

RESEND_API_KEY=
EMAIL_FROM="TripLink <bookings@triplink.in>"

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
TURNSTILE_SECRET_KEY=

REF_COOKIE_SECRET=                    # 32+ chars (openssl rand -base64 48). HMAC for the tl_ref attribution cookie. Required for attribution.
PII_ENCRYPTION_KEY=                   # base64 32 bytes, AES-256-GCM (prefix ciphertexts with key version)
IP_HASH_SALT=                         # rotate daily via date suffix
CRON_SECRET=

SENTRY_AUTH_TOKEN=

# Instagram API with Instagram Login (ARCHITECTURE §20.2) — Meta app → Instagram → API setup with Instagram login
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Dev only: lets you pick a follower count instead of real Instagram while App Review is pending. Never in production.
ALLOW_IG_SIMULATION=false
# Dev only: one-click sign-in as the seeded test users (password from supabase/seed.sql). Never in production.
ALLOW_DEV_LOGIN=false
DEV_LOGIN_PASSWORD=
